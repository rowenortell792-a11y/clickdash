});

// --- 2. CORE KERNEL & CITADEL ---
app.get('/api/core', (req, res) => {
    try {
        const ledgerPath = path.join(__dirname, 'ggc_ledger.json');
        const ledger = fs.existsSync(ledgerPath) 
            ? JSON.parse(fs.readFileSync(ledgerPath, 'utf8')) 
            : { status: "INITIALIZING" };

        res.json({
            subsystem: "CITADEL_NEURAL_CORE",
            kernel: "heartbeatcore.js",
            ledgerState: ledger
        });
    } catch (err) {
        res.status(500).json({ error: "Core sync error", details: err.message });
    }
});

