/**
 * GGC_UNIVERSE: SATELLITE_TELEMETRY_BRIDGE
 * HOST: clickdash.net
 * ROLE: Ingress-to-Orbital Telemetry Stream Sync
 */

const https = require('https');

const pushTelemetryPacket = (payload) => {
    const data = JSON.stringify({
        source: "clickdash-motherbot-v1",
        timestamp: new Date().toISOString(),
        metrics: payload
    });

    const options = {
        hostname: 'clickdash.net',
        port: 443,
        path: '/api/telemetry/ingress',
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Content-Length': data.length,
            'X-Sovereign-Node': 'Active'
        }
    };

    const req = https.request(options, (res) => {
        let responseBody = '';
        res.on('data', (chunk) => {
            responseBody += chunk;
        });
        res.on('end', () => {
            console.log(`[TELEMETRY_SYNC]: Packet delivered successfully. Response: ${responseBody}`);
        });
    });

    req.on('error', (error) => {
        console.error(`[TELEMETRY_ERROR]: ${error.message}`);
    });

    req.write(data);
    req.end();
};

module.exports = { pushTelemetryPacket };
